{
  "name": "games-app",
  "version": "1.1.0",
  "private": true,
  "description": "Responsive personal video game collection and wishlist manager",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "covers:normalize": "node scripts/normalize-covers.js",
    "covers:showcase": "node scripts/generate-cover-showcase.js",
    "docs:build": "node scripts/generate-docs.js",
    "docs:check": "node scripts/generate-docs.js --check",
    "client:check": "node --experimental-vm-modules scripts/check-client-modules.js",
    "test:browser": "node scripts/check-browser-flows.js",
    "test:server": "node scripts/check-server-flows.js",
    "test": "node --test && npm run client:check && node scripts/generate-docs.js --check"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "geoip-lite": "2.0.3",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=20"
  }
}
