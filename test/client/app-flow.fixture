// Served by scripts/check-browser-flows.js in an isolated real browser.
const nativeFetch = window.fetch.bind(window);
const errors = [];
window.addEventListener('error', event => errors.push(event.message));
window.addEventListener('unhandledrejection', event => errors.push(String(event.reason?.stack || event.reason)));
const check = (condition, message) => { if (!condition) throw new Error(message); };
const waitFor = async (condition, message) => {
  for (let attempt = 0; attempt < 150; attempt++) {
    if (condition()) return;
    await new Promise(resolve => setTimeout(resolve, 20));
  }
  throw new Error(message);
};
const mode = new URLSearchParams(location.search).get('mode') || 'guest';
check(getComputedStyle(document.documentElement).overflow === 'hidden', 'Startup prevents root scrollbar flashes');
check(getComputedStyle(document.body).overflow === 'hidden', 'Startup prevents body scrollbar flashes');
let testViewport;
if (mode === 'mobile') {
  testViewport = Object.assign(new EventTarget(), { width: innerWidth, height: innerHeight, offsetLeft: 0, offsetTop: 0 });
  Object.defineProperty(window, 'visualViewport', { configurable: true, value: testViewport });
}
let signedIn = mode !== 'guest';
const user = { id: 17, username: 'TestCollector', email: '', avatarUrl: null };
const progress = { xp: 500, level: 0, title: 'Collector', currentLevelXp: 0, nextLevelXp: 1000, progress: 50 };
let games = [
  { id: 1, title: 'Portal 2', platform: 'Steam', ownership: 'owned', playStatus: 'backlog', pegi: 12, mediaFormats: ['digital'], rating: 3, pegiDescriptors: [], pegiReleases: [] },
  { id: 2, title: 'Portal 2', platform: 'Nintendo Switch', ownership: 'owned', playStatus: 'backlog', pegi: 12, mediaFormats: ['physical'], pegiDescriptors: [], pegiReleases: [] },
];
let eventController;
let eventConnections = 0;
let libraryRequests = 0;
window.EventSource = class {
  addEventListener() {}
  close() {}
};
window.fetch = async (target, options = {}) => {
  const url = new URL(target, location.origin);
  const reply = (value, status = 200) => new Response(JSON.stringify(value), { status, headers: { 'Content-Type': 'application/json' } });
  if (['/katalog', '/signal', '/forum'].includes(url.pathname)) return nativeFetch(`/fixtures${url.pathname}.html`);
  if (url.pathname === '/cover-showcase.json') return reply({ covers: [] });
  if (!url.pathname.startsWith('/api/')) return nativeFetch(target, options);
  if (url.pathname === '/api/config') return reply({ version: 'test-version' });
  if (url.pathname === '/api/auth/me') return reply(signedIn ? { user, preferences: {}, progress } : { error: 'Unauthorized' }, signedIn ? 200 : 401);
  if (url.pathname === '/api/login') { signedIn = true; return reply({ user, preferences: {}, progress }); }
  if (url.pathname === '/api/logout') { signedIn = false; return reply({}); }
  if (url.pathname === '/api/events') {
    eventConnections++;
    const stream = new ReadableStream({ start(controller) {
      eventController = controller;
      options.signal?.addEventListener('abort', () => { try { controller.close(); } catch {} });
    } });
    return new Response(stream, { headers: { 'Content-Type': 'text/event-stream' } });
  }
  if (url.pathname === '/api/games' && options.method === 'POST') {
    const game = { ...JSON.parse(options.body), id: 3 }; games.push(game); return reply(game, 201);
  }
  if (url.pathname === '/api/games') { libraryRequests++; return reply({ games, total: 1, page: 1, pages: 1 }); }
  if (/^\/api\/games\/\d+$/.test(url.pathname)) return reply(games.find(game => game.id === Number(url.pathname.split('/').at(-1))));
  if (url.pathname === '/api/stats') return reply({ total: games.length });
  if (url.pathname === '/api/meta') return reply({ platforms: ['Steam', 'Nintendo Switch'], integrations: {}, user });
  if (url.pathname === '/api/showcase/covers') return reply({ covers: [] });
  if (url.pathname === '/api/activity') return reply({ entries: [] });
  if (url.pathname === '/api/progression') return reply(progress);
  if (url.pathname === '/api/titles/autocomplete') return reply({ existing: [], catalogue: [], suggestions: [] });
  if (url.pathname === '/api/ping') return reply({ threads: [], unread: 0 });
  if (url.pathname === '/api/preferences') return reply({});
  if (url.pathname.includes('/status')) return reply({ configured: false, missing: 0, job: null });
  if (url.pathname.startsWith('/api/steam') || url.pathname.startsWith('/api/gog')) return reply({ connected: false });
  throw new Error(`Unmocked API request: ${url.pathname}`);
};

try {
  await import('/app.js');
  await import('/js/shell/mobile-action-dock.js');
  const boot = await import('/js/boot/init.js');
  if (!signedIn) {
    await waitFor(() => !document.documentElement.classList.contains('resuming-session'), 'Guest startup stalled');
    check(!document.querySelector('#auth-screen').hidden, 'Guest authentication visible');
    document.querySelector('[data-auth-mode="register"]').click();
    check(!document.querySelector('#auth-email-label').hidden, 'Registration email visible');
    document.querySelector('[data-auth-mode="login"]').click();
    document.querySelector('#auth-username').value = user.username;
    document.querySelector('#auth-password').value = 'test-password-123';
    document.querySelector('#auth-form').requestSubmit();
  }
  await waitFor(() => !document.querySelector('#app-shell').hidden && document.querySelector('.game-card'), 'Authenticated library did not mount');
  await waitFor(() => !document.documentElement.classList.contains('resuming-session'), 'Session resume did not finish');
  check(getComputedStyle(document.documentElement).overflowY !== 'hidden', 'Startup restores normal page scrolling');
  check(getComputedStyle(document.body).position !== 'fixed', 'Startup releases the temporary body lock');
  check(document.querySelector('#header-progression [data-header-progress-meter]').value === 50, 'XP fill restored');
  const textSize = selector => parseFloat(getComputedStyle(document.querySelector(selector)).fontSize);
  check(textSize('.game-meta') >= 13, 'Card metadata remains readable');
  check(textSize('.platform-tag') >= 12, 'Compact platform labels remain readable');
  check(textSize('#account-current-password') >= 14, 'Profile password input remains readable');
  check(textSize('#search') >= 14, 'Library search remains readable');
  check(textSize('.filters label > span') === 12, 'Filter captions remain quieter than controls');
  check(textSize('.stat-card small') === 12, 'Stat captions use the compact caption scale');
  const cardRating = document.querySelector('.card-rating-picker');
  check(cardRating.scrollWidth <= cardRating.clientWidth + 1, 'Card rating text fits its control');
  check(getComputedStyle(cardRating.querySelector('output')).whiteSpace === 'nowrap', 'Rating score stays on one line');
  check(!cardRating.querySelector('.card-rating-inline-label'), 'Card rating omits the redundant visible label');
  if (matchMedia('(max-width: 520px)').matches) {
    check(textSize('#account-current-password') >= 16, 'Mobile profile input avoids browser focus zoom');
  }
  if (testViewport) {
    await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
    check(document.documentElement.clientWidth === 390, `Mobile viewport width: ${document.documentElement.clientWidth}, inner ${innerWidth}, screen ${screen.width}; ` +
      [...document.querySelectorAll('body *')].filter(node => node.getBoundingClientRect().right > 391 && getComputedStyle(node).visibility !== 'hidden').slice(0, 12).map(node => `${node.tagName}.${node.className}:${Math.round(node.getBoundingClientRect().right)}`).join(', '));
    check(document.documentElement.scrollWidth <= document.documentElement.clientWidth,
      `Mobile page overflows horizontally: ${document.documentElement.scrollWidth}/${document.documentElement.clientWidth} ` +
      [...document.querySelectorAll('body *')].filter(node => node.getBoundingClientRect().right > 391 && getComputedStyle(node).visibility !== 'hidden').slice(0, 12).map(node => `${node.tagName}.${node.className}:${Math.round(node.getBoundingClientRect().right)}`).join(', '));
    const dock = document.querySelector('.mobile-action-dock');
    check(dock && getComputedStyle(dock).position === 'fixed', 'Mobile actions use the floating dock');
    check(dock.getBoundingClientRect().bottom <= testViewport.height && dock.getBoundingClientRect().top >= 0, 'Mobile dock is visible before any scroll event');
    testViewport.height = innerHeight - 80;
    document.documentElement.classList.add('fixture-viewport-settle');
    await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(() => requestAnimationFrame(resolve))));
    check(document.documentElement.style.getPropertyValue('--mobile-viewport-bottom') === '80px', 'Dock remeasures after startup-state changes without scrolling');
    document.documentElement.classList.remove('fixture-viewport-settle');
    testViewport.height = innerHeight - 160;
    testViewport.offsetTop = 40;
    testViewport.dispatchEvent(new Event('resize'));
    check(document.documentElement.style.getPropertyValue('--mobile-viewport-bottom') === '120px', 'Dock tracks the visible bottom inset');
    check(dock.getBoundingClientRect().bottom <= testViewport.offsetTop + testViewport.height, 'Mobile dock stays above the visible bottom edge');
    testViewport.width = 260;
    testViewport.offsetLeft = 20;
    testViewport.dispatchEvent(new Event('scroll'));
    check(dock.getBoundingClientRect().left >= testViewport.offsetLeft, 'Dock follows the visible left edge');
    check(dock.getBoundingClientRect().right <= testViewport.offsetLeft + testViewport.width, 'Dock fits a narrow visible viewport');
    Object.assign(testViewport, { width: innerWidth, height: innerHeight, offsetLeft: 0, offsetTop: 0 });
    testViewport.dispatchEvent(new Event('resize'));
  }
  const mountedHeader = document.querySelector('#app-shell .topbar');
  check(mountedHeader, 'Shared header is mounted');
  const { katalogNavigation } = await import('/js/boot/navigation.js');
  await katalogNavigation.open('/katalog');
  if (testViewport) check(document.documentElement.scrollWidth <= 390, 'Public katalog fits the phone viewport');
  check(textSize('.katalog-search input') >= 14, 'Public search shares the readable input scale');
  check(document.querySelector('#library-view').hidden, 'Public view switches content');
  check(document.querySelector('#app-shell .topbar') === mountedHeader, 'Header preserved across navigation');
  await katalogNavigation.open('/signal');
  if (testViewport) check(document.documentElement.scrollWidth <= 390, 'Signal fits the phone viewport');
  await katalogNavigation.open('/forum');
  if (testViewport) check(document.documentElement.scrollWidth <= 390, 'Forum fits the phone viewport');
  document.querySelector('[data-add-game]').click();
  check(document.querySelector('#game-dialog').open, 'Add game opens from another view');
  document.querySelector('[data-close]').click();
  katalogNavigation.showLibrary();
  const selector = document.querySelector('.platform-switch');
  check(selector, 'Grouped game has platform selector');
  selector.click();
  document.querySelector('[data-action="version"][data-game-id="2"]').click();
  const card = document.querySelector('.game-card');
  check(card.dataset.id === '2', 'Platform selection changes selected record');
  card.querySelector('[data-action="edit"]').click();
  check(document.querySelector('#game-dialog').open && document.querySelector('#game-id').value === '2', 'Selected platform opens in editor');
  document.querySelector('[data-close]').click();
  document.querySelector('#account-button').click();
  check(document.querySelector('#account-dialog').open, 'Profile opens');
  check(document.activeElement.tagName !== 'INPUT', 'Profile does not focus a text input');
  document.querySelector('[data-account-close]').click();
  boot.initializeApp();
  check(eventConnections === 1, 'Repeated bootstrap does not duplicate event streams');
  eventController.enqueue(new TextEncoder().encode('event: version-updated\ndata: {"version":"live-test"}\n\n'));
  await waitFor(() => document.querySelector('#app-version').textContent === 'live-test', 'SSE version update failed');
  eventController.enqueue(new TextEncoder().encode(`event: progression-updated\ndata: ${JSON.stringify({ progress: { ...progress, xp: 600, progress: 60 } })}\n\n`));
  await waitFor(() => document.querySelector('#header-progression [data-header-progress-meter]').value === 60, 'SSE XP update failed');
  const { showAuth, enterApp } = await import('/js/account/session.js');
  document.querySelector('[data-add-game]').click();
  const { confirmAction } = await import('/js/ui-helpers/dialogs.js');
  const confirmation = confirmAction({ message: 'Session lifecycle check' });
  const search = document.querySelector('#search'); search.value = 'pending'; search.dispatchEvent(new Event('input'));
  const requestsBeforeLogout = libraryRequests;
  showAuth('Session expired');
  check(!document.querySelector('dialog[open]'), 'Session loss closes every modal');
  check(await confirmation === false, 'Closing confirmation on session loss settles its promise');
  await new Promise(resolve => setTimeout(resolve, 250));
  check(libraryRequests === requestsBeforeLogout, 'Session loss cancels pending library search');
  check(document.querySelector('#header-progression').hidden, 'Old XP is hidden after session loss');
  await enterApp(user, {}, progress);
  check(document.querySelector('#header-progression [data-header-progress-meter]').value === 50, 'Next session restores its own XP');
  await new Promise(resolve => setTimeout(resolve, 100));
  check(errors.length === 0, errors.join('\n'));
  const { activityFeed } = await import('/js/boot/services.js');
  const { state } = await import('/js/core/runtime.js');
  state.stopEvents?.(); activityFeed.stop();
  await nativeFetch('/report', { method: 'POST', body: JSON.stringify({ ok: true, mode }) });
} catch (error) {
  await nativeFetch('/report', { method: 'POST', body: JSON.stringify({ ok: false, mode, error: error.stack, errors }) });
}
